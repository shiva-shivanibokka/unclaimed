# The simulator's settings, defined once. The environment overrides any of them;
# infra/deploy.sh reads this file too (the models also set the Bedrock permissions).
# Alexa's live voice: Amazon Nova 2 Sonic (speech to speech) and its voice (US English:
# tiffany or matthew).
SONIC_MODEL_ID=amazon.nova-2-sonic-v1:0
SONIC_VOICE=tiffany
# Public and free, so live conversations are capped (Nova Sonic bills by the audio token: a
# few cents a minute, measured Oct 5): open at once, in all and per client; started per
# client per hour; minutes per day, in all and per client; minutes per conversation; and
# seconds of silence before it rests (it carries on after "Alexa").
LIVE_AT_ONCE=10
LIVE_PER_IP_AT_ONCE=2
LIVE_PER_IP_PER_HOUR=30
LIVE_MINUTES_PER_DAY=120
LIVE_PER_IP_MINUTES_PER_DAY=30
LIVE_MAX_MINUTES=20
LIVE_QUIET_SECONDS=40
# The text pipeline (agent.turn), used by the research evaluations (eval/e3.py, tier_c.py).
SIMULATOR_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0
