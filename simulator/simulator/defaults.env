# The simulator's settings, defined once. The environment overrides any of them;
# infra/deploy.sh reads this file too (the model also sets the Bedrock permission).
SIMULATOR_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0
# Public and free, so Bedrock use is capped: turns per client per hour, and tokens Bedrock
# bills at the full rate (new input, cache writes, output) per day. A screening uses ~50K.
TURNS_PER_IP_PER_HOUR=120
FULL_RATE_TOKENS_PER_DAY=3000000
